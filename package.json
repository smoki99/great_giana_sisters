{
  "name": "mia-in-candy-land-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "import": "$HOME/.local/bin/godot --headless --path game --import",
    "check": "bun scripts/check-gd.ts",
    "unit": "$HOME/.local/bin/godot --headless --path game -s res://tests/run_tests.gd",
    "export": "$HOME/.local/bin/godot --headless --path game --export-release Web ../build/web/index.html",
    "zip": "bun scripts/zip-web.ts",
    "serve": "bun scripts/serve-web.ts build/web 8060",
    "ci": "bun scripts/ci.ts"
  },
  "dependencies": {
    "@ast-grep/cli": "^0.51.3",
    "@coding-solo/godot-mcp": "^0.1.1",
    "@glutamateapp/blender-mcp-ts": "^0.10.0",
    "fflate": "^0.8.3",
    "tar-stream": "^3.2.2",
    "typescript": "^7.0.2",
    "typescript-language-server": "^6.1.0",
    "xz-decompress": "^0.2.3"
  }
}
